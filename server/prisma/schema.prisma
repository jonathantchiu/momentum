generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String
  name            String
  preferences     Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  refreshTokens   RefreshToken[]
  recipes         Recipe[]
  mealPlans       MealPlan[]
  pantryItems     PantryItem[]
  nutritionTarget DailyNutritionTarget?
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Recipe {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  servings      Int            @default(1)
  instructions  String         @default("")
  sourceUrl     String?
  imageUrl      String?
  prepTimeMin   Int?
  cookTimeMin   Int?
  ingredients   Ingredient[]
  mealPlanItems MealPlanItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Ingredient {
  id         String  @id @default(cuid())
  recipeId   String
  recipe     Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name       String
  quantity   Float
  unit       String
  calories   Float?
  proteinG   Float?
  carbsG     Float?
  fatG       Float?
  fiberG     Float?
  usdaFoodId String?
}

model MealPlan {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime       @db.Date
  items     MealPlanItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, weekStart])
}

model MealPlanItem {
  id        String   @id @default(cuid())
  planId    String
  plan      MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id])
  dayOfWeek Int
  mealType  String
}

model PantryItem {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  quantity   Float
  unit       String
  expiryDate DateTime? @db.Date
  usdaFoodId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model DailyNutritionTarget {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  calories Int    @default(2000)
  proteinG Int    @default(150)
  carbsG   Int    @default(250)
  fatG     Int    @default(65)
  fiberG   Int    @default(30)
}
